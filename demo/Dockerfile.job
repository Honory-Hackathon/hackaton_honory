FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir rasterio==1.4.3 numpy pandas pyarrow geopandas shapely google-cloud-storage
WORKDIR /app
COPY bldg_shade_job.py .
RUN python -c "import rasterio, geopandas, pandas; print(rasterio.__version__)"
ENTRYPOINT ["python", "bldg_shade_job.py"]
